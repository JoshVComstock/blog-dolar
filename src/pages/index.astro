---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CountryCard from '../components/CountryCard.astro';
import DateStamp from '../components/DateStamp.astro';
import AdSensePlaceholder from '../components/AdSensePlaceholder.astro';
import { fetchAllBoards } from '../utils/api.js';
import { isoDate } from '../utils/format.js';
import { getCollection } from 'astro:content';
import { breadcrumb, faqPage, webPage, website, organization } from '../utils/seo.js';
import { SITE } from '../utils/site.js';

const boards = await fetchAllBoards({ series: false, p2p: false });
const stamps = boards.map((board) => board.measuredAt).filter(Boolean).sort();
const measuredAt = stamps.length ? stamps[stamps.length - 1] : null;
const withParallel = boards.filter((board) => board.country.hasParallel);

const notes = (await getCollection('notas'))
  .sort((a, b) => (a.data.fecha < b.data.fecha ? 1 : -1))
  .slice(0, 3);

const title = 'Dólar hoy en Latinoamérica — precio por país | Cambio Claro';
const description =
  'Precio del dólar en Bolivia, Argentina, Venezuela, Colombia, México, Perú, Chile y Uruguay. Oficial y paralelo, comparador de plataformas, calculadora e histórico.';

const faq = [
  {
    q: '¿Cada cuánto se actualizan los precios?',
    a: 'El sitio se regenera cada veinte minutos y toma los datos en ese momento. La hora exacta de cada medición aparece junto a la cifra, en la columna Medido.'
  },
  {
    q: '¿Cuál es la diferencia entre el dólar oficial y el paralelo?',
    a: 'El oficial es el que fija o publica la autoridad monetaria y rige las operaciones bancarias. El paralelo se forma en el mercado informal, cuando conseguir dólares por la vía oficial se vuelve difícil. En Bolivia, Argentina y Venezuela los dos pueden separarse bastante, y esa diferencia es la brecha.'
  },
  {
    q: '¿Puedo usar estos valores para una operación real?',
    a: 'Son valores de referencia. El precio final en un banco, una casa de cambio o una plataforma digital puede diferir por comisiones, impuestos y márgenes de cada operador.'
  },
  {
    q: '¿De dónde salen los datos?',
    a: 'Las cotizaciones vienen de dolarapi.com y open.er-api.com; el comparador de plataformas, de criptoya.com. El histórico viene de fuentes públicas de cada país y, donde no existe ninguna, de nuestro propio registro diario. Está todo detallado en la página de metodología.'
  },
  {
    q: '¿Puedo usar estos datos en mi propio sitio?',
    a: 'Sí. Publicamos una API pública en /api/v1/rates.json, en JSON, sin clave y con licencia CC BY 4.0. Solo pedimos que cites la fuente.'
  }
];

const jsonLd = [
  website(description),
  organization,
  webPage(title, description, '/', measuredAt),
  breadcrumb([{ name: 'Cambio Claro', path: '/' }]),
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Precio del dólar por país en Latinoamérica',
    numberOfItems: boards.length,
    itemListElement: boards.map((board, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: `Dólar hoy en ${board.country.name}`,
      url: `${SITE}/${board.country.code}/dolar-hoy`
    }))
  },
  faqPage(faq)
];
---

<BaseLayout
  title={title}
  description={description}
  canonical="/"
  jsonLd={jsonLd}
  modifiedTime={isoDate(measuredAt)}
>
  <div class="mx-auto max-w-shell px-4 sm:px-6 lg:px-8">
    <section aria-labelledby="portada" class="py-9 md:py-12">
      <div class="flex flex-wrap items-start justify-between gap-x-8 gap-y-4">
        <div>
          <h1
            id="portada"
            class="max-w-[16ch] text-[clamp(1.875rem,4.6vw,2.875rem)] font-bold leading-[1.06]"
            style="color: var(--ink)"
          >
            El dólar hoy en Latinoamérica
          </h1>
          <p class="mt-3.5 max-w-note text-[1.0625rem] leading-relaxed" style="color: var(--ink-soft)">
            Ocho países, cada cotización con su nombre y la hora en que fue medida. Donde hay dólar
            paralelo, lo verás al lado del oficial.
          </p>
        </div>
        <DateStamp measuredAt={measuredAt} timezone={null} tone="paper" prefix="Última medición" />
      </div>
    </section>

    <section aria-labelledby="tablero" class="leaf overflow-hidden">
      <h2 id="tablero" class="sr-only">Precio del dólar por país</h2>
      <div class="band flex items-center gap-x-6 px-4 py-2 sm:px-5">
        <p class="label min-w-[8rem] flex-1 sm:flex-none" style="color: var(--ink-faint)">País</p>
        <p class="label hidden flex-1 sm:block" style="color: var(--ink-faint)">
          Precio de venta y variación
        </p>
      </div>
      <div class="ruled">
        {boards.map((board) => <CountryCard board={board} />)}
      </div>
    </section>

    {
      withParallel.length > 0 && (
        <p class="mt-3.5 text-[0.875rem] leading-relaxed" style="color: var(--ink-faint)">
          {withParallel.map((board) => board.country.name).join(', ')} tienen mercado paralelo, así
          que en su fila verás dos precios y la brecha entre ellos.
        </p>
      )
    }

    <div class="mt-10">
      <AdSensePlaceholder slot="horizontal" />
    </div>

    <div class="mt-12 grid gap-7 lg:grid-cols-2">
      <section aria-labelledby="preguntas" class="leaf-flat overflow-hidden">
        <div class="px-4 pt-5 sm:px-5">
          <SectionHeader
            id="preguntas"
            title="Preguntas frecuentes"
            hint="Lo que casi todo el mundo pregunta antes de cambiar plata."
          />
        </div>
        <dl class="mt-3">
          {
            faq.map((item) => (
              <div class="border-t px-4 py-4 sm:px-5" style="border-color: var(--rule)">
                <dt class="text-[0.9375rem] font-bold leading-snug" style="color: var(--ink)">
                  {item.q}
                </dt>
                <dd class="mt-2 text-[0.9375rem] leading-relaxed" style="color: var(--ink-soft)">
                  {item.a}
                </dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section aria-labelledby="notas" class="leaf-flat overflow-hidden">
        <div class="flex items-baseline justify-between gap-4 px-4 pt-5 sm:px-5">
          <SectionHeader
            id="notas"
            title="Notas"
            hint="Cómo funciona el mercado cambiario, explicado sin jerga."
            tight
          />
          <a href="/notas" class="label no-underline" style="color: var(--ink-faint)">Ver todas</a>
        </div>
        <div class="mt-4">
          {
            notes.map((note) => (
              <a
                href={`/notas/${note.id}`}
                class="block border-t px-4 py-4 no-underline transition-colors duration-150 hover:bg-[var(--paper-band)] sm:px-5"
                style="border-color: var(--rule)"
              >
                <p class="text-[0.9375rem] font-bold leading-snug" style="color: var(--ink)">
                  {note.data.titulo}
                </p>
                <p class="mt-1.5 text-[0.875rem] leading-relaxed" style="color: var(--ink-faint)">
                  {note.data.resumen}
                </p>
              </a>
            ))
          }
        </div>
      </section>
    </div>

    <section aria-labelledby="api" class="mt-12 rule-strong-top pt-5">
      <SectionHeader
        id="api"
        title="Los datos son públicos"
        hint="Si quieres usar estas cotizaciones en tu propio proyecto, hay un JSON abierto, sin clave y con licencia CC BY 4.0."
      />
      <div class="mt-4 flex flex-wrap gap-2">
        <a
          href="/api/v1/rates.json"
          class="inline-block rounded-[2px] border px-3 py-2 figure text-[0.8125rem] font-semibold no-underline transition-opacity duration-150 hover:opacity-70"
          style="border-color: var(--rule-strong); color: var(--ink)"
        >
          /api/v1/rates.json
        </a>
        {
          boards.map((board) => (
            <a
              href={`/api/v1/${board.country.code}/rates.json`}
              class="inline-block rounded-[2px] border px-3 py-2 figure text-[0.8125rem] no-underline transition-opacity duration-150 hover:opacity-70"
              style="border-color: var(--rule); color: var(--ink-soft)"
            >
              /{board.country.code}
            </a>
          ))
        }
      </div>
    </section>

    <div class="mt-12">
      <AdSensePlaceholder slot="inline" />
    </div>
  </div>
</BaseLayout>
