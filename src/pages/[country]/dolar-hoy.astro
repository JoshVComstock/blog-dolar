---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DateStamp from '../../components/DateStamp.astro';
import Movement from '../../components/Movement.astro';
import RateLedger from '../../components/RateLedger.astro';
import HistoryChart from '../../components/HistoryChart.astro';
import CountryFacts from '../../components/CountryFacts.astro';
import CountryCard from '../../components/CountryCard.astro';
import AdSensePlaceholder from '../../components/AdSensePlaceholder.astro';
import CurrencyCalculator from '../../components/CurrencyCalculator.jsx';
import { getCollection } from 'astro:content';
import { fetchAllBoards, fetchBoard } from '../../utils/api.js';
import { formatFigure, isoDate } from '../../utils/format.js';

export async function getStaticPaths() {
  const light = await fetchAllBoards({ series: false });
  const boards = await Promise.all(light.map((board) => fetchBoard(board.country.code)));
  const notes = (await getCollection('notas')).sort((a, b) => (a.data.fecha < b.data.fecha ? 1 : -1));
  return boards.map((board) => ({
    params: { country: board.country.code },
    props: {
      board,
      notes: notes.slice(0, 3),
      others: light.filter((entry) => entry.country.code !== board.country.code).slice(0, 4)
    }
  }));
}

const { board, others, notes } = Astro.props;
const { country, rates, primary, profile, series, spread, available, measuredAt } = board;

const official = rates.find((rate) => rate.key === 'oficial');
const parallel = rates.find((rate) => rate.indicative && rate.key !== 'oficial');
const pair = country.hasParallel && official && parallel ? [official, parallel] : null;

const canonical = `/${country.code}/dolar-hoy`;
const title = `Dólar hoy en ${country.name} — precio oficial y paralelo | Cambio Claro`;
const description = available
  ? `Precio del dólar en ${country.name}: ${country.symbol} ${formatFigure(primary.sell, country.locale, country.decimals)} (${primary.label.toLowerCase()}). Calculadora, histórico y todas las cotizaciones.`
  : `Precio del dólar en ${country.name}, calculadora de conversión a ${country.currencyName.toLowerCase()} y contexto del mercado cambiario.`;

const faq = [
  {
    q: `¿A cuánto está el dólar hoy en ${country.name}?`,
    a: available
      ? `La cotización ${primary.label.toLowerCase()} está en ${country.symbol} ${formatFigure(primary.sell, country.locale, country.decimals)} por dólar para la venta. La hora exacta de la medición aparece arriba, en el sello de fecha.`
      : `Ahora mismo la fuente no devolvió una cotización para ${country.name}. La página se regenera cada vez que el sitio se actualiza.`
  },
  {
    q: `¿Cuántos tipos de dólar hay en ${country.name}?`,
    a: `Esta página muestra ${rates.length} ${rates.length === 1 ? 'cotización' : 'cotizaciones'}. ${country.variantsNote}`
  },
  {
    q: `¿Cómo convierto dólares a ${country.currencyName.toLowerCase()}?`,
    a: 'Escribe el monto en la calculadora de esta página. Al cambiar la cantidad se recalculan todas las cotizaciones a la vez, así puedes comparar cuánto recibes en cada mercado.'
  },
  {
    q: `¿Sube o baja el dólar en ${country.name}?`,
    a: series
      ? `Puedes verlo en el gráfico de esta página, construido con ${series.points.length} lecturas de ${series.source}.`
      : 'Todavía no tenemos suficientes lecturas registradas para mostrar la tendencia de este país. El gráfico aparece solo en cuanto haya historial.'
  }
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Cambio Claro', item: 'https://cambioclaro.com' },
      {
        '@type': 'ListItem',
        position: 2,
        name: `Dólar hoy en ${country.name}`,
        item: `https://cambioclaro.com${canonical}`
      }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a }
    }))
  }
];

if (available) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'ExchangeRateSpecification',
    name: `Dólar estadounidense a ${country.currencyName}`,
    currency: 'USD',
    currentExchangeRate: {
      '@type': 'UnitPriceSpecification',
      price: Number(primary.sell.toFixed(country.decimals)),
      priceCurrency: country.currency
    },
    exchangeRateSpread: spread ? Number(spread.value.toFixed(2)) : undefined
  });
}
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  activeCountry={country.code}
  jsonLd={jsonLd}
  modifiedTime={isoDate(measuredAt)}
>
  <div class="mx-auto max-w-shell px-4 py-8 sm:px-6 lg:px-8 lg:py-10">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_21rem] lg:items-start xl:gap-10">
        <article class="leaf spine overflow-hidden lg:col-start-1 lg:row-start-1">
          <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-3 sm:px-6" style="background-color: var(--cover); color: var(--cover-ink)">
            <p class="label" style="opacity: 0.82">
              {profile && profile.capital ? profile.capital.split(',')[0] : country.name} ·
              {' '}{country.currency}
            </p>
            <DateStamp measuredAt={measuredAt} timezone={country.timezone} tone="cover" />
          </div>

          <div class="ruled-paper px-4 py-7 sm:px-6 sm:py-8" style="--rule-step: 2.75rem; --rule-offset: 1.4rem">
            <h1 class="text-[1.375rem] font-bold leading-tight" style="color: var(--ink)">
              Dólar hoy en {country.name}
            </h1>

            {
              available && pair ? (
                <div class="mt-7 grid gap-x-10 gap-y-7 sm:grid-cols-2">
                  {pair.map((rate) => (
                    <div class="min-w-0">
                      <p class="label mb-2.5" style={rate.key === primary.key ? 'color: var(--deposit)' : 'color: var(--ink-faint)'}>
                        {rate.label}
                        {rate.indicative ? ' · indicativa' : ''}
                      </p>
                      <p class="figure-pair flex items-baseline gap-1.5" style="color: var(--ink)">
                        <span class="text-[0.34em] font-semibold" style="color: var(--ink-faint)">
                          {country.symbol}
                        </span>
                        {formatFigure(rate.sell, country.locale, country.decimals)}
                      </p>
                      <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
                        <Movement
                          change={rate.change}
                          changePct={rate.changePct}
                          locale={country.locale}
                          decimals={country.decimals}
                        />
                        <span class="figure-cell" style="color: var(--ink-faint)">
                          compra {formatFigure(rate.buy, country.locale, country.decimals)}
                        </span>
                      </div>
                    </div>
                  ))}
                </div>
              ) : available ? (
                <div class="mt-7">
                  <p class="label mb-2.5" style="color: var(--deposit)">
                    {primary.label}
                  </p>
                  <p class="figure-balance flex items-baseline gap-2" style="color: var(--ink)">
                    <span class="text-[0.3em] font-semibold" style="color: var(--ink-faint)">
                      {country.symbol}
                    </span>
                    {formatFigure(primary.sell, country.locale, country.decimals)}
                  </p>
                  <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2">
                    <Movement
                      change={primary.change}
                      changePct={primary.changePct}
                      locale={country.locale}
                      decimals={country.decimals}
                    />
                    <span class="figure-cell" style="color: var(--ink-faint)">
                      compra {formatFigure(primary.buy, country.locale, country.decimals)} · venta{' '}
                      {formatFigure(primary.sell, country.locale, country.decimals)}
                    </span>
                  </div>
                </div>
              ) : (
                <div class="mt-6">
                  <p class="figure-row" style="color: var(--ink-faint)">
                    <span aria-hidden="true">— —</span>
                  </p>
                  <p class="mt-4 max-w-note text-[1rem] leading-relaxed" style="color: var(--ink-soft)">
                    Ninguna fuente devolvió una cotización para {country.name} al generar esta página.
                    No mostramos un valor anterior, porque un dato viejo presentado como actual es peor
                    que ningún dato.
                  </p>
                </div>
              )
            }

            {
              spread && (
                <div
                  class="mt-7 flex flex-wrap items-center gap-x-3 gap-y-1 rounded-xl px-4 py-3.5"
                  style="background-color: var(--paper-band)"
                >
                  <span class="label" style="color: var(--ink-faint)">
                    Brecha
                  </span>
                  <span class="figure text-[1.0625rem] font-bold" style="color: var(--ink)">
                    {`${spread.value > 0 ? '+' : ''}${spread.value.toFixed(1).replace('.', ',')} %`}
                  </span>
                  <span class="text-[0.875rem]" style="color: var(--ink-soft)">
                    es lo que el {spread.label.toLowerCase()} se separa del oficial
                  </span>
                </div>
              )
            }

            <p class="mt-7 max-w-note text-[1rem] leading-[1.7]" style="color: var(--ink-soft)">
              {country.context}
            </p>
          </div>
        </article>

      <aside class="min-w-0 space-y-6 lg:col-start-2 lg:row-start-1 lg:row-span-2 lg:sticky lg:top-6">
        {
          available ? (
            <CurrencyCalculator
              client:load
              rates={rates}
              currency={country.currency}
              currencyName={country.currencyName}
              symbol={country.symbol}
              locale={country.locale}
              decimals={country.decimals}
              countryName={country.name}
              primaryKey={primary.key}
            />
          ) : (
            <div class="leaf-flat px-4 py-5 sm:px-5">
              <p class="text-[0.9375rem] font-bold" style="color: var(--ink)">
                Convertir
              </p>
              <p class="mt-2 text-[0.875rem] leading-relaxed" style="color: var(--ink-faint)">
                La calculadora vuelve en cuanto haya una cotización que aplicar.
              </p>
            </div>
          )
        }

        <div class="hidden lg:block">
          <AdSensePlaceholder slot="rectangle" />
        </div>

        <section aria-labelledby="stub-notas" class="hidden lg:block">
          <h2 id="stub-notas" class="rule-strong-top pt-4 text-[0.9375rem] font-bold" style="color: var(--ink)">
            Para entender el cambio
          </h2>
          <ul class="mt-1">
            {notes.map((note) => (
              <li>
                <a
                  href={`/notas/${note.id}`}
                  class="block border-t py-3.5 text-[0.875rem] font-semibold leading-snug no-underline transition-colors duration-200 hover:text-[var(--deposit)]"
                  style="border-color: var(--rule); color: var(--ink-soft)"
                >
                  {note.data.titulo}
                </a>
              </li>
            ))}
          </ul>
        </section>
      </aside>

        <div class="lg:col-start-1 lg:row-start-2 min-w-0 space-y-8">
        {series ? (
          <HistoryChart series={series} country={country} />
        ) : (
          <section class="leaf-flat px-4 py-6 sm:px-6">
            <h2 class="text-[1.0625rem] font-bold" style="color: var(--ink)">
              El histórico de {country.name} lo estamos construyendo
            </h2>
            <p class="mt-2.5 max-w-note text-[0.9375rem] leading-relaxed" style="color: var(--ink-soft)">
              Ninguna institución publica una serie histórica para este país, así que guardamos
              nuestra propia lectura cada vez que el sitio se actualiza. El gráfico aparece aquí en
              cuanto haya suficientes registros.
            </p>
          </section>
        )}

        {available && <RateLedger rates={rates} country={country} primaryKey={primary.key} />}

        <div class="lg:hidden">
          <AdSensePlaceholder slot="horizontal" />
        </div>

        <CountryFacts profile={profile} country={country} />

        <section aria-labelledby="preguntas" class="rule-strong-top pt-5">
          <h2 id="preguntas" class="text-[1.0625rem] font-bold" style="color: var(--ink)">
            Preguntas frecuentes
          </h2>
          <div class="mt-3 max-w-note">
            {
              faq.map((item) => (
                <details class="group border-t py-4" style="border-color: var(--rule)">
                  <summary
                    class="flex cursor-pointer list-none items-start justify-between gap-4 text-[0.9375rem] font-semibold leading-snug"
                    style="color: var(--ink)"
                  >
                    {item.q}
                    <span
                      class="mt-0.5 shrink-0 transition-transform duration-300 ease-settle group-open:rotate-45"
                      style="color: var(--ink-faint)"
                      aria-hidden="true"
                    >
                      <svg width="15" height="15" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                        <path d="M7 1.5v11M1.5 7h11" />
                      </svg>
                    </span>
                  </summary>
                  <p class="mt-2.5 text-[0.9375rem] leading-relaxed" style="color: var(--ink-soft)">
                    {item.a}
                  </p>
                </details>
              ))
            }
          </div>
        </section>

        <section aria-labelledby="otros" class="leaf-flat overflow-hidden">
          <h2 id="otros" class="px-4 pt-5 text-[1.0625rem] font-bold sm:px-6" style="color: var(--ink)">
            El dólar en otros países
          </h2>
          <div class="mt-3 stagger divide-y" style="border-color: var(--rule)">
            {others.map((entry, index) => <CountryCard board={entry} index={index} />)}
          </div>
        </section>
        </div>
    </div>
  </div>
</BaseLayout>
