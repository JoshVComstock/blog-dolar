---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import HistoryChart from '../../components/HistoryChart.astro';
import AdSensePlaceholder from '../../components/AdSensePlaceholder.astro';
import { fetchAllBoards, fetchBoard } from '../../utils/api.js';
import { formatFigure, isoDate, formatLongDay } from '../../utils/format.js';
import { breadcrumb, faqPage, webPage, speakable } from '../../utils/seo.js';

export async function getStaticPaths() {
  const light = await fetchAllBoards({ series: false, p2p: false, fx: false });
  const boards = await Promise.all(
    light.map((board) => fetchBoard(board.country.code, { p2p: false, fx: false }))
  );
  return boards
    .filter((board) => board.series && board.series.points.length > 1)
    .map((board) => ({ params: { country: board.country.code }, props: { board } }));
}

const { board } = Astro.props;
const { country, series, measuredAt } = board;
const { locale, decimals, symbol, name } = country;

const canonical = `/${country.code}/historico`;
const points = [...series.points].reverse();
const last = series.points[series.points.length - 1];
const first = series.points[0];
const values = series.points.map((point) => point.value);
const min = Math.min(...values);
const max = Math.max(...values);
const change = first.value ? ((last.value - first.value) / first.value) * 100 : 0;

const rows = points.slice(0, 60).map((point, index) => {
  const previous = points[index + 1];
  const delta = previous && previous.value ? ((point.value - previous.value) / previous.value) * 100 : null;
  return { date: point.date, value: point.value, delta };
});

const title = `Histórico del dólar en ${name}: ${series.points.length} lecturas | Cambio Claro`;
const answer = `Entre ${formatLongDay(first.date)} y ${formatLongDay(last.date)} el dólar en ${name} pasó de ${symbol} ${formatFigure(first.value, locale, decimals)} a ${symbol} ${formatFigure(last.value, locale, decimals)}, un ${change >= 0 ? '+' : '−'}${Math.abs(change).toFixed(1).replace('.', ',')} %.`;
const description = `${answer} Tabla día a día y gráfico de la serie completa.`;

const faq = [
  {
    q: `¿Cómo evolucionó el dólar en ${name}?`,
    a: `${answer} El mínimo del período fue ${symbol} ${formatFigure(min, locale, decimals)} y el máximo ${symbol} ${formatFigure(max, locale, decimals)}.`
  },
  {
    q: '¿De dónde sale esta serie?',
    a: series.own
      ? 'Ninguna institución publica una serie histórica para este país. La construimos nosotros guardando la lectura del día cada vez que el sitio se actualiza.'
      : `La serie viene de ${series.source}, una fuente pública que publica el dato oficial.`
  },
  {
    q: '¿Puedo descargar los datos?',
    a: `Sí. Están en /api/v1/${country.code}/rates.json, en JSON, sin clave y con licencia CC BY 4.0.`
  }
];

const jsonLd = [
  webPage(title, description, canonical, measuredAt),
  breadcrumb([
    { name: 'Cambio Claro', path: '/' },
    { name: `Dólar hoy en ${name}`, path: `/${country.code}/dolar-hoy` },
    { name: 'Histórico', path: canonical }
  ]),
  faqPage(faq),
  speakable(canonical)
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  activeCountry={country.code}
  lang={locale}
  locale={`es_${country.code.toUpperCase()}`}
  image={`/og/${country.code}.png`}
  jsonLd={jsonLd}
  modifiedTime={isoDate(measuredAt)}
>
  <div class="mx-auto max-w-shell px-4 py-7 sm:px-6 lg:px-8">
    <nav aria-label="Ruta" class="stamp" style="color: var(--ink-faint)">
      <a href="/" class="no-underline hover:underline">Cambio Claro</a>
      <span aria-hidden="true"> / </span>
      <a href={`/${country.code}/dolar-hoy`} class="no-underline hover:underline">
        Dólar hoy en {name}
      </a>
    </nav>

    <h1 class="mt-5 text-[clamp(1.5rem,3.4vw,2rem)] font-bold leading-tight" style="color: var(--ink)">
      Histórico del dólar en {name}
    </h1>
    <p
      data-respuesta
      class="mt-3 max-w-note text-[1.0625rem] font-semibold leading-snug"
      style="color: var(--ink)"
    >
      {answer}
    </p>

    <div class="mt-7 space-y-7">
      <HistoryChart series={series} country={country} />

      <section aria-labelledby="tabla" class="leaf-flat overflow-hidden">
        <div class="px-4 pt-5 sm:px-5">
          <SectionHeader
            id="tabla"
            title="Lectura por lectura"
            meta={`${rows.length} de ${series.points.length}`}
            hint="De la más reciente a la más antigua. La variación compara con la lectura anterior."
          />
        </div>
        <div class="mt-4 overflow-x-auto">
          <table class="w-full border-collapse text-left">
            <thead>
              <tr class="band">
                <th scope="col" class="px-4 py-2.5 label font-semibold sm:px-5" style="color: var(--ink-faint)">
                  Fecha
                </th>
                <th scope="col" class="px-3 py-2.5 text-right label font-semibold" style="color: var(--ink-faint)">
                  Valor
                </th>
                <th scope="col" class="px-4 py-2.5 text-right label font-semibold sm:px-5" style="color: var(--ink-faint)">
                  Variación
                </th>
              </tr>
            </thead>
            <tbody>
              {
                rows.map((row) => (
                  <tr class="border-t" style="border-color: var(--rule)">
                    <th scope="row" class="px-4 py-2.5 stamp font-normal sm:px-5" style="color: var(--ink-soft)">
                      <time datetime={row.date}>{formatLongDay(row.date)}</time>
                    </th>
                    <td class="px-3 py-2.5 text-right figure-cell font-bold" style="color: var(--ink)">
                      {symbol} {formatFigure(row.value, locale, decimals)}
                    </td>
                    <td class="px-4 py-2.5 text-right figure-cell sm:px-5" style="color: var(--ink-faint)">
                      {row.delta === null
                        ? '—'
                        : `${row.delta > 0 ? '+' : row.delta < 0 ? '−' : '±'}${Math.abs(row.delta).toFixed(2).replace('.', ',')} %`}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      <AdSensePlaceholder slot="horizontal" />

      <section aria-labelledby="preguntas" class="rule-strong-top pt-5">
        <SectionHeader id="preguntas" title="Preguntas frecuentes" />
        <dl class="mt-3 max-w-note">
          {
            faq.map((item) => (
              <div class="border-t py-4" style="border-color: var(--rule)">
                <dt class="text-[0.9375rem] font-bold leading-snug" style="color: var(--ink)">
                  {item.q}
                </dt>
                <dd class="mt-2 text-[0.9375rem] leading-relaxed" style="color: var(--ink-soft)">
                  {item.a}
                </dd>
              </div>
            ))
          }
        </dl>
      </section>
    </div>
  </div>
</BaseLayout>
