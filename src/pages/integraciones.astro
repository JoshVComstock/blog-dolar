---
import TextPage from '../layouts/TextPage.astro';
import { countryList } from '../utils/countries.js';
import { SITE } from '../utils/site.js';
import { breadcrumb, webPage, organization } from '../utils/seo.js';

const canonical = '/integraciones';
const title = 'Widget y API para tu sitio | Cambio Claro';
const description =
  'Pon la cotización del dólar en tu web con un iframe de una línea, o consume el JSON abierto. Gratis, sin clave y con licencia CC BY 4.0.';

const countries = countryList();

const jsonLd = [
  webPage(title, description, canonical, new Date().toISOString()),
  organization,
  breadcrumb([
    { name: 'Cambio Claro', path: '/' },
    { name: 'Integraciones', path: canonical }
  ])
];
---

<TextPage
  title={title}
  description={description}
  canonical={canonical}
  heading="Pon la cotización en tu sitio"
  lead="Un iframe de una línea o un JSON abierto. Sin clave, sin registro y sin coste. Lo único que pedimos es que cites la fuente."
  jsonLd={jsonLd}
>
  <h2>El widget</h2>
  <p>
    Copia esta línea y pégala donde quieras que aparezca la cotización. Cambia <code>bo</code> por el
    código del país que necesites.
  </p>
  <pre
    class="overflow-x-auto rounded-[3px] px-3 py-3 text-[0.8125rem]"
    style="background-color: var(--paper-band); color: var(--ink-soft); font-family: theme('fontFamily.mono')"
  >{`<iframe src="${SITE}/widget/bo" width="320" height="140" style="border:0" loading="lazy" title="Dólar hoy en Bolivia"></iframe>`}</pre>

  <p>
    Acepta <code>?theme=light</code> y <code>?theme=dark</code>. Sin el parámetro sigue el tema del
    navegador de quien lo mira. No lleva cookies ni scripts de terceros.
  </p>

  <h3>Códigos de país</h3>
  <ul>
    {countries.map((country) => (
      <li>
        <code>{country.code}</code> — {country.name} (<a href={`/widget/${country.code}`}>ver</a>)
      </li>
    ))}
  </ul>

  <h2>La API</h2>
  <p>
    Si prefieres los datos crudos, <a href="/api">la API pública</a> devuelve todas las cotizaciones,
    las plataformas P2P y la serie histórica en JSON.
  </p>

  <h2>Condiciones</h2>
  <p>
    Licencia CC BY 4.0: puedes usar los datos, incluso comercialmente, siempre que cites
    <strong>Cambio Claro</strong> con un enlace a la página del país. No hay límite de peticiones
    razonable, pero el widget y la API se regeneran cada veinte minutos: consultarlos más seguido no
    devuelve datos más frescos.
  </p>
</TextPage>
