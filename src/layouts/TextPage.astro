---
import BaseLayout from './BaseLayout.astro';

const { title, description, canonical, heading, lead, updated, jsonLd = [] } = Astro.props;
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <div class="mx-auto max-w-shell px-4 py-9 sm:px-6 lg:px-8 md:py-12">
    <h1
      class="max-w-[20ch] text-[clamp(1.75rem,4.2vw,2.5rem)] font-bold leading-[1.07]"
      style="color: var(--ink)"
    >
      {heading}
    </h1>
    {
      lead && (
        <p class="mt-3.5 max-w-note text-[1.0625rem] leading-relaxed" style="color: var(--ink-soft)">
          {lead}
        </p>
      )
    }
    {
      updated && (
        <p class="mt-3.5 stamp" style="color: var(--ink-faint)">
          Actualizado el {updated}
        </p>
      )
    }

    <div class="prose-note mt-8 max-w-note">
      <slot />
    </div>
  </div>
</BaseLayout>
