---
const { slot = 'horizontal', label = 'Publicidad' } = Astro.props;
const client = import.meta.env.PUBLIC_ADSENSE_CLIENT || '';

const sizes = {
  horizontal: 'min-h-[100px]',
  rectangle: 'min-h-[250px]',
  inline: 'min-h-[160px]'
};
---

{
  client && (
    <aside
      role="complementary"
      aria-label={label}
      data-ad-slot={slot}
      data-ad-client={client}
      class={`flex items-center justify-center rounded-[4px] border ${sizes[slot] || sizes.horizontal}`}
      style="border-color: var(--rule); background-color: var(--paper-band)"
    >
      <p class="label" style="color: var(--ink-faint)">{label}</p>
    </aside>
  )
}
