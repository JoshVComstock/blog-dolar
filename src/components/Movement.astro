---
import { formatDelta, formatPercent, trendWord } from '../utils/format.js';

const {
  change = null,
  changePct = null,
  locale = 'es',
  decimals = 2,
  size = 'md'
} = Astro.props;

const hasChange = Number.isFinite(change);
const rising = hasChange && change > 0;
const flat = hasChange && change === 0;
const tone = !hasChange || flat ? 'var(--ink-faint)' : rising ? 'var(--deposit)' : 'var(--withdraw)';
const wash = !hasChange || flat ? 'transparent' : rising ? 'var(--deposit-wash)' : 'var(--withdraw-wash)';
const arrow = rising ? 'M8 3.4 13 9H9.2v4.6H6.8V9H3z' : 'M8 13.6 3 8h3.8V3.4h2.4V8H13z';
const scale = size === 'sm' ? 'text-[0.75rem] px-1.5 py-1 gap-1' : 'text-[0.8125rem] px-2 py-1.5 gap-1.5';
---

{
  hasChange ? (
    <span
      class={`movement inline-flex items-center rounded-md font-mono font-semibold tabular-nums ${scale}`}
      data-dir={flat ? 'flat' : rising ? 'up' : 'down'}
      style={`color: ${tone}; background-color: ${wash}`}
    >
      {!flat && (
        <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d={arrow} />
        </svg>
      )}
      {flat && <span aria-hidden="true">=</span>}
      <span>{formatPercent(changePct, locale) || formatDelta(change, locale, decimals)}</span>
      <span class="sr-only">{trendWord(change)} frente al cierre anterior</span>
    </span>
  ) : (
    <span class="movement label" data-dir="none" style="color: var(--ink-faint)">
      <span aria-hidden="true">sin dato de ayer</span>
      <span class="sr-only">La fuente no publica un cierre anterior con el que comparar</span>
    </span>
  )
}
