---
import Movement from './Movement.astro';
import Icon from './Icon.astro';
import { formatFigure } from '../utils/format.js';

const { board } = Astro.props;
const { country, primary, rates, spread, available } = board;
const { locale, decimals, symbol } = country;

const official = rates.find((rate) => rate.key === 'oficial');
const showsPair = Boolean(country.hasParallel && official && primary && official.key !== primary.key);
---

<a
  href={`/${country.code}/dolar-hoy`}
  class="group block px-4 py-4 no-underline transition-colors duration-150 hover:bg-[var(--paper-band)] focus-visible:bg-[var(--paper-band)] sm:px-5"
>
  <div class="flex flex-wrap items-center gap-x-6 gap-y-3 sm:flex-nowrap">
    <div class="min-w-[8rem] flex-1 sm:flex-none">
      <h3 class="text-[1rem] font-bold leading-tight" style="color: var(--ink)">{country.name}</h3>
      <p class="mt-0.5 text-[0.8125rem]" style="color: var(--ink-faint)">{country.currencyName}</p>
    </div>

    {
      available ? (
        <div class="flex flex-1 flex-wrap items-end gap-x-7 gap-y-3">
          <div>
            <p class="mb-1.5 label" style="color: var(--ink-faint)">{primary.label}</p>
            <p class="figure-row" style="color: var(--ink)">
              <span class="mr-1 text-[0.62em] font-medium" style="color: var(--ink-faint)">
                {symbol}
              </span>
              {formatFigure(primary.sell, locale, decimals)}
            </p>
          </div>

          {showsPair && (
            <div>
              <p class="mb-1.5 label" style="color: var(--ink-faint)">{official.label}</p>
              <p class="figure-row" style="color: var(--ink-soft)">
                <span class="mr-1 text-[0.62em] font-medium" style="color: var(--ink-faint)">
                  {symbol}
                </span>
                {formatFigure(official.sell, locale, decimals)}
              </p>
            </div>
          )}

          <div class="flex items-center gap-3">
            <Movement
              change={primary.change}
              changePct={primary.changePct}
                        since={primary.previousDate}
              locale={locale}
              decimals={decimals}
              size="sm"
            />
            {spread && (
              <span class="stamp whitespace-nowrap" style="color: var(--ink-faint)">
                {`brecha ${spread.value > 0 ? '+' : ''}${spread.value.toFixed(1).replace('.', ',')} %`}
              </span>
            )}
          </div>
        </div>
      ) : (
        <div class="flex-1">
          <p class="figure-row" style="color: var(--ink-faint)">
            <span aria-hidden="true">— —</span>
            <span class="sr-only">Cotización no disponible</span>
          </p>
          <p class="mt-1 stamp" style="color: var(--ink-faint)">la fuente no respondió</p>
        </div>
      )
    }

    <span
      class="ml-auto inline-flex h-7 w-7 shrink-0 items-center justify-center transition-transform duration-200 group-hover:translate-x-1"
      style="color: var(--ink-faint)"
      aria-hidden="true"
    >
      <Icon name="chevron" size={14} />
    </span>
  </div>
</a>
