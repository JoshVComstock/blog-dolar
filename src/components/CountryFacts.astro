---
import SectionHeader from './SectionHeader.astro';
import { formatCompact } from '../utils/format.js';

const { profile, country } = Astro.props;

const rows = profile
  ? [
      { label: 'Capital', value: profile.capital },
      { label: 'Moneda', value: `${country.currencyName} (${country.currency})` },
      { label: 'Región', value: profile.region },
      { label: 'Población', value: formatCompact(profile.population, country.locale) },
      { label: 'Superficie', value: `${formatCompact(profile.area, country.locale)} km²` },
      { label: 'Idiomas', value: profile.languages }
    ].filter((row) => row.value)
  : [];
---

{
  rows.length > 0 && (
    <section aria-labelledby="ficha" class="rule-strong-top pt-5">
      <SectionHeader
        id="ficha"
        title={`${country.name} en datos`}
        hint="Contexto del país para entender de qué mercado hablamos."
      />

      <dl class="mt-3 grid grid-cols-2 lg:grid-cols-3">
        {rows.map((row) => (
          <div class="border-t py-3.5 pr-6" style="border-color: var(--rule)">
            <dt class="label" style="color: var(--ink-faint)">{row.label}</dt>
            <dd class="mt-1.5 text-[0.9375rem] leading-snug" style="color: var(--ink)">
              {row.value}
            </dd>
          </div>
        ))}
      </dl>
    </section>
  )
}
