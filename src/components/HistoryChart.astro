---
import SectionHeader from './SectionHeader.astro';
import { formatFigure, formatDay } from '../utils/format.js';

const { series, country } = Astro.props;
const points = series && Array.isArray(series.points) ? series.points : [];

const W = 720;
const H = 200;
const PAD_X = 6;
const PAD_TOP = 14;
const PAD_BOTTOM = 18;

const values = points.map((point) => point.value);
const min = values.length ? Math.min(...values) : 0;
const max = values.length ? Math.max(...values) : 0;
const span = max - min || max * 0.02 || 1;
const stepX = points.length > 1 ? (W - PAD_X * 2) / (points.length - 1) : 0;

const toX = (index) => PAD_X + index * stepX;
const toY = (value) => PAD_TOP + (1 - (value - min) / span) * (H - PAD_TOP - PAD_BOTTOM);

const line = points.map((point, index) => `${toX(index).toFixed(1)},${toY(point.value).toFixed(1)}`);
const linePath = line.length ? 'M' + line.join(' L') : '';
const areaPath = line.length
  ? `${linePath} L${toX(points.length - 1).toFixed(1)},${H - PAD_BOTTOM} L${PAD_X},${H - PAD_BOTTOM} Z`
  : '';

const first = points.length ? points[0] : null;
const last = points.length ? points[points.length - 1] : null;
const delta = first && last && first.value ? ((last.value - first.value) / first.value) * 100 : null;
const gradientId = `spark-${country.code}`;
---

{
  points.length > 1 && (
    <section aria-labelledby="historico" class="leaf-flat overflow-hidden">
      <div class="px-4 pt-5 sm:px-5">
        <SectionHeader
          id="historico"
          title="Cómo viene moviéndose"
          meta={`${points.length} lecturas · ${series.source}`}
          hint={`Cada punto es una medición del ${series.label.toLowerCase()}. La línea sube cuando el dólar se encarece.`}
        />
      </div>

      <div class="mt-4 px-2 sm:px-3">
        <svg
          viewBox={`0 0 ${W} ${H}`}
          class="h-[200px] w-full"
          role="img"
          aria-label={`Evolución del dólar en ${country.name} entre ${formatDay(first.date)} y ${formatDay(last.date)}, de ${formatFigure(first.value, country.locale, country.decimals)} a ${formatFigure(last.value, country.locale, country.decimals)} ${country.currency}`}
        >
          <defs>
            <linearGradient id={gradientId} x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="var(--ink)" stop-opacity="0.14" />
              <stop offset="100%" stop-color="var(--ink)" stop-opacity="0" />
            </linearGradient>
          </defs>

          <line
            x1={PAD_X}
            y1={H - PAD_BOTTOM}
            x2={W - PAD_X}
            y2={H - PAD_BOTTOM}
            stroke="var(--rule)"
            stroke-width="1"
          />
          <path d={areaPath} fill={`url(#${gradientId})`} />
          <path
            d={linePath}
            fill="none"
            stroke="var(--ink)"
            stroke-width="1.75"
            stroke-linejoin="round"
            stroke-linecap="round"
          />
          <circle cx={toX(points.length - 1)} cy={toY(last.value)} r="3.5" fill="var(--ink)" />
        </svg>
      </div>

      <div class="grid grid-cols-2 gap-px border-t sm:grid-cols-4" style="border-color: var(--rule); background-color: var(--rule)">
        {[
          { label: formatDay(first.date), value: first.value, strong: false },
          { label: 'Mínimo', value: min, strong: false },
          { label: 'Máximo', value: max, strong: false },
          { label: formatDay(last.date), value: last.value, strong: true }
        ].map((cell) => (
          <div class="px-4 py-3 sm:px-5" style="background-color: var(--paper-leaf)">
            <p class="label" style="color: var(--ink-faint)">{cell.label}</p>
            <p
              class:list={['mt-1.5 figure-cell', cell.strong ? 'font-bold' : '']}
              style={cell.strong ? 'color: var(--ink)' : 'color: var(--ink-soft)'}
            >
              {country.symbol} {formatFigure(cell.value, country.locale, country.decimals)}
            </p>
          </div>
        ))}
      </div>

      <p class="border-t px-4 py-4 text-[0.875rem] leading-relaxed sm:px-5" style="border-color: var(--rule); color: var(--ink-faint)">
        {delta !== null && (
          <strong style="color: var(--ink-soft)">
            {`${delta > 0 ? '+' : delta < 0 ? '−' : '±'}${Math.abs(delta).toFixed(1).replace('.', ',')} % en el período. `}
          </strong>
        )}
        {series.own
          ? 'Ninguna institución publica esta serie. La construimos nosotros: cada vez que el sitio se actualiza guardamos la lectura del día.'
          : `Serie pública de ${series.source}.`}
      </p>
    </section>
  )
}
