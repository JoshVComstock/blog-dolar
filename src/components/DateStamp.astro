---
import { formatStamp, isDateOnly } from '../utils/format.js';

const { measuredAt, timezone, tone = 'cover', prefix = 'Medido' } = Astro.props;
const stamp = formatStamp(measuredAt, timezone);
const live = Boolean(measuredAt);
const color = tone === 'cover' ? 'var(--cover-ink)' : 'var(--ink-soft)';
const border = tone === 'cover' ? 'rgba(250,250,248,0.32)' : 'var(--rule-strong)';
const suffix = live && !isDateOnly(measuredAt) ? ` ${timezone ? 'hora local' : 'UTC'}` : '';
---

<span
  class="inline-flex items-center gap-2 rounded-[2px] border px-2 py-1 stamp"
  style={`color: ${color}; border-color: ${border}`}
>
  <span style="opacity: 0.7">{prefix}</span>
  <time datetime={measuredAt || undefined}>{stamp}{suffix}</time>
</span>
