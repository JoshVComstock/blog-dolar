---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../SectionHeader.astro';
import DateStamp from '../DateStamp.astro';
import AdSensePlaceholder from '../AdSensePlaceholder.astro';
import { formatFigure, isoDate, formatLongDay } from '../../utils/format.js';
import { AMOUNTS, forwardSlug, reverseSlug, READABLE, SINGULAR } from '../../utils/amounts.js';
import { breadcrumb, faqPage, webPage, speakable } from '../../utils/seo.js';

const { board, plan } = Astro.props;
const { country, rates, primary, measuredAt } = board;
const { locale, decimals, symbol, currency, name } = country;

const { amount, canonical, heading, unitFrom, unitTo, symbolOut, decimalsOut, rateLabel, intro } = plan;

const amountText = new Intl.NumberFormat(locale, { maximumFractionDigits: 0 }).format(amount);

const rows = rates
  .map((rate) => {
    const applied = plan.appliedFor(rate);
    return {
      label: rate.label,
      indicative: rate.indicative,
      applied,
      total: applied ? plan.convert(amount, applied) : null
    };
  })
  .filter((row) => row.total !== null)
  .sort((a, b) => b.total - a.total);

const best = rows.length ? rows[0] : null;
const leadRate = primary ? plan.appliedFor(primary) : null;
const lead = leadRate ? plan.convert(amount, leadRate) : null;
const money = (value) => `${symbolOut} ${formatFigure(value, locale, decimalsOut)}`;

const title = plan.title
  ? lead
    ? `${plan.title}: ${money(lead)} hoy | Cambio Claro`
    : `${plan.title} — cuánto es hoy | Cambio Claro`
  : lead
    ? `${amountText} ${unitFrom} a ${unitTo}: ${money(lead)} hoy | Cambio Claro`
    : `${amountText} ${unitFrom} a ${unitTo} — cuánto es hoy | Cambio Claro`;

const answer = lead
  ? plan.answer
    ? plan.answer(money(lead), primary.label.toLowerCase())
    : `${amountText} ${unitFrom} son ${money(lead)} al cambio ${primary.label.toLowerCase()} de ${name}.`
  : `Ahora mismo no tenemos una cotización para convertir ${amountText} ${unitFrom} a ${unitTo}.`;

const description = lead
  ? `${answer} Resultado en cada cotización, con la hora exacta de la medición.`
  : `Conversión de ${amountText} ${unitFrom} a ${unitTo} con el tipo de cambio de ${name}.`;

const faq = [
  {
    q: plan.question || `¿Cuánto son ${amountText} ${unitFrom} en ${unitTo}?`,
    a: lead && best
      ? `${answer} Al cambio ${best.label.toLowerCase()} son ${money(best.total)}, que es lo máximo que obtendrías hoy.`
      : answer
  },
  {
    q: `¿Qué precio se aplica?`,
    a: rateLabel
  },
  {
    q: '¿Sirve para una operación real?',
    a: 'Es una referencia. El importe final puede variar por comisiones, márgenes del operador e impuestos, y el precio cambia durante el día.'
  }
];

const jsonLd = [
  webPage(title, description, canonical, measuredAt),
  breadcrumb([
    { name: 'Cambio Claro', path: '/' },
    { name: `Dólar hoy en ${name}`, path: `/${country.code}/dolar-hoy` },
    { name: heading, path: canonical }
  ]),
  faqPage(faq),
  speakable(canonical)
];

const siblings = plan.siblingSlug
  ? AMOUNTS.filter((value) => value !== amount).map((value) => ({
      value,
      href: `/${country.code}/${plan.siblingSlug(value)}`
    }))
  : [];

const quickTable =
  !plan.siblingSlug && leadRate
    ? (plan.quickAmounts || [1, 10, 50, 100, 500, 1000]).map((value) => ({
        value,
        total: plan.convert(value, leadRate)
      }))
    : [];

const other = plan.direction === 'usd-local'
  ? { href: `/${country.code}/${reverseSlug(amount, currency)}`, label: `${amountText} ${READABLE[currency]} a dólares` }
  : plan.direction === 'local-usd'
    ? { href: `/${country.code}/${forwardSlug(amount, currency)}`, label: `${amountText} dólares a ${READABLE[currency]}` }
    : null;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  activeCountry={country.code}
  lang={locale}
  locale={`es_${country.code.toUpperCase()}`}
  image={`/og/${country.code}.png`}
  jsonLd={jsonLd}
  modifiedTime={isoDate(measuredAt)}
>
  <div class="mx-auto max-w-shell px-4 py-7 sm:px-6 lg:px-8">
    <nav aria-label="Ruta" class="stamp" style="color: var(--ink-faint)">
      <a href="/" class="no-underline hover:underline">Cambio Claro</a>
      <span aria-hidden="true"> / </span>
      <a href={`/${country.code}/dolar-hoy`} class="no-underline hover:underline">
        Dólar hoy en {name}
      </a>
    </nav>

    <div class="mt-5 grid gap-7 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-start">
      <article class="leaf spine overflow-hidden lg:col-start-1 lg:row-start-1">
        <div
          class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-2.5 sm:px-5"
          style="background-color: var(--cover); color: var(--cover-ink)"
        >
          <p class="label" style="opacity: 0.72">{plan.pairLabel}</p>
          <DateStamp measuredAt={measuredAt} timezone={country.timezone} tone="cover" />
        </div>

        <div class="px-4 py-6 sm:px-5">
          <h1 class="text-[1.375rem] font-bold leading-tight" style="color: var(--ink)">
            {heading}
          </h1>
          <p
            data-respuesta
            class="mt-2.5 max-w-note text-[1.0625rem] font-semibold leading-snug"
            style="color: var(--ink)"
          >
            {answer}
          </p>

          {
            lead ? (
              <div class="mt-6">
                <p class="label mb-2" style="color: var(--ink-faint)">
                  {primary.label} · {plan.sideLabel}
                </p>
                <p class="figure-balance flex items-baseline gap-2" style="color: var(--ink)">
                  <span class="text-[0.3em] font-semibold" style="color: var(--ink-faint)">
                    {symbolOut}
                  </span>
                  {formatFigure(lead, locale, decimalsOut)}
                </p>
                <p class="mt-3 figure-cell" style="color: var(--ink-faint)">
                  {plan.rateLine(leadRate)}
                </p>
              </div>
            ) : (
              <p class="mt-6 figure-row" style="color: var(--ink-faint)">
                <span aria-hidden="true">— —</span>
              </p>
            )
          }

          {intro && (
            <p class="mt-6 max-w-note text-[0.9375rem] leading-[1.7]" style="color: var(--ink-soft)">
              {intro}
            </p>
          )}
        </div>
      </article>

      <aside class="min-w-0 space-y-6 lg:col-start-2 lg:row-start-1 lg:row-span-2 lg:sticky lg:top-5">
        <section aria-labelledby="otros-montos" class="leaf-flat px-4 py-4">
          <SectionHeader
            id="otros-montos"
            title={siblings.length ? 'Otros montos' : 'Tabla rápida'}
            hint={
              siblings.length
                ? 'La misma conversión con otras cantidades.'
                : `Cuánto sale cada cantidad al cambio ${primary ? primary.label.toLowerCase() : 'actual'}.`
            }
          />
          {siblings.length > 0 && (
            <ul class="mt-3 flex flex-wrap gap-2">
              {siblings.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="inline-block rounded-[2px] border px-2.5 py-1.5 figure text-[0.8125rem] font-semibold no-underline transition-opacity duration-150 hover:opacity-70"
                    style="border-color: var(--rule); color: var(--ink-soft)"
                  >
                    {new Intl.NumberFormat(locale, { maximumFractionDigits: 0 }).format(item.value)}
                  </a>
                </li>
              ))}
            </ul>
          )}
          {quickTable.length > 0 && (
            <dl class="mt-3">
              {quickTable.map((item) => (
                <div
                  class="flex items-baseline justify-between gap-4 border-t py-2.5"
                  style="border-color: var(--rule)"
                >
                  <dt class="figure text-[0.8125rem]" style="color: var(--ink-faint)">
                    {plan.symbolIn} {new Intl.NumberFormat(locale, { maximumFractionDigits: 0 }).format(item.value)}
                  </dt>
                  <dd class="figure-cell font-bold" style="color: var(--ink)">
                    {symbolOut} {formatFigure(item.total, locale, decimalsOut)}
                  </dd>
                </div>
              ))}
            </dl>
          )}
          {other && (
            <p class="mt-4 border-t pt-3 text-[0.875rem]" style="border-color: var(--rule)">
              <a href={other.href} style="color: var(--ink)">{other.label} →</a>
            </p>
          )}
        </section>

        <AdSensePlaceholder slot="rectangle" />
      </aside>

      <div class="min-w-0 space-y-7 lg:col-start-1 lg:row-start-2">
        {
          rows.length > 0 && (
            <section aria-labelledby="por-cotizacion" class="leaf-flat overflow-hidden">
              <div class="px-4 pt-5 sm:px-5">
                <SectionHeader
                  id="por-cotizacion"
                  title={plan.rowsTitle || `${amountText} ${unitFrom} en cada cotización`}
                  meta={`${rows.length} ${rows.length === 1 ? 'resultado' : 'resultados'}`}
                  hint="Ordenado de mayor a menor: arriba está donde más obtienes."
                />
              </div>
              <ul class="mt-4 border-t" style="border-color: var(--rule)">
                {rows.map((row, index) => (
                  <li
                    class:list={[
                      'flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b px-4 py-3.5 sm:px-5',
                      index === 0 ? 'row-invert' : ''
                    ]}
                    style="border-color: var(--rule)"
                  >
                    <span class="flex items-baseline gap-2">
                      <span class="text-[0.9375rem] font-semibold">{row.label}</span>
                      {index === 0 && <span class="label" style="opacity: 0.6">obtienes más</span>}
                    </span>
                    <span class="flex items-baseline gap-4">
                      <span class="figure text-[0.75rem]" style="opacity: 0.62">
                        {plan.rateLine(row.applied)}
                      </span>
                      <span class="figure text-[1.0625rem] font-bold tracking-[-0.03em]">
                        {symbolOut} {formatFigure(row.total, locale, decimalsOut)}
                      </span>
                    </span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <section aria-labelledby="preguntas" class="rule-strong-top pt-5">
          <SectionHeader
            id="preguntas"
            title="Preguntas frecuentes"
            hint={`Actualizado el ${formatLongDay(isoDate(measuredAt) || new Date().toISOString())}.`}
          />
          <dl class="mt-3 max-w-note">
            {
              faq.map((item) => (
                <div class="border-t py-4" style="border-color: var(--rule)">
                  <dt class="text-[0.9375rem] font-bold leading-snug" style="color: var(--ink)">
                    {item.q}
                  </dt>
                  <dd class="mt-2 text-[0.9375rem] leading-relaxed" style="color: var(--ink-soft)">
                    {item.a}
                  </dd>
                </div>
              ))
            }
          </dl>
        </section>

        <p class="text-[0.9375rem]" style="color: var(--ink-soft)">
          <a href={`/${country.code}/dolar-hoy`} style="color: var(--ink)">
            Ver todas las cotizaciones del dólar en {name}
          </a>
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
