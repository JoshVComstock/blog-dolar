---
import SectionHeader from './SectionHeader.astro';
import Movement from './Movement.astro';
import { formatFigure, formatStamp } from '../utils/format.js';

const { rates = [], country, primaryKey } = Astro.props;
const { locale, decimals, symbol, timezone, name } = country;

const hasTrend = rates.some((rate) => Number.isFinite(rate.change));
const SEED = 100;
---

<section aria-labelledby="cotizaciones" class="leaf-flat overflow-hidden">
  <div class="px-4 pt-5 sm:px-5">
    <SectionHeader
      id="cotizaciones"
      title={`Todas las cotizaciones de ${name}`}
      meta={`${rates.length} ${rates.length === 1 ? 'cotización' : 'cotizaciones'}`}
      hint="Compra es lo que te pagan por tu dólar. Venta es lo que te cobran por dártelo. La última columna se recalcula sola cuando cambias el monto en la calculadora."
    />
  </div>

  <div class="mt-4 overflow-x-auto">
    <table
      class="w-full border-collapse text-left"
      data-ledger
      data-decimals={decimals}
      data-locale={locale}
    >
      <caption class="sr-only">
        Cotizaciones del dólar en {name} con compra, venta, variación, hora de medición y el
        equivalente de tu monto.
      </caption>
      <thead>
        <tr class="band">
          <th scope="col" class="px-4 py-2.5 label font-semibold sm:px-5" style="color: var(--ink-faint)">
            Cotización
          </th>
          <th scope="col" class="hidden px-3 py-2.5 text-right label font-semibold sm:table-cell" style="color: var(--ink-faint)">
            Compra
          </th>
          <th scope="col" class="px-3 py-2.5 text-right label font-semibold" style="color: var(--ink-faint)">
            Venta
          </th>
          {hasTrend && (
            <th scope="col" class="hidden px-3 py-2.5 text-right label font-semibold md:table-cell" style="color: var(--ink-faint)">
              Ayer
            </th>
          )}
          <th scope="col" class="px-3 py-2.5 text-right label font-semibold" style="color: var(--ink-faint)">
            <span data-ledger-head>Con 100 USD</span>
          </th>
          <th scope="col" class="hidden px-4 py-2.5 text-right label font-semibold sm:px-5 lg:table-cell" style="color: var(--ink-faint)">
            Medido
          </th>
        </tr>
      </thead>
      <tbody>
        {
          rates.map((rate) => (
            <tr class:list={['border-t', rate.key === primaryKey ? 'row-invert' : '']} style="border-color: var(--rule)">
              <th scope="row" class="px-4 py-3.5 align-middle font-normal sm:px-5">
                <span class="block text-[0.9375rem] font-bold" style="color: var(--ink)">
                  {rate.label}
                </span>
                <span class="mt-1 block stamp sm:hidden" style="color: var(--ink-faint)">
                  compra {formatFigure(rate.buy, locale, decimals)}
                </span>
                {rate.indicative && (
                  <span class="mt-1 hidden stamp sm:block" style="color: var(--ink-faint)">
                    indicativa
                  </span>
                )}
              </th>
              <td class="hidden px-3 py-3.5 text-right align-middle figure-cell sm:table-cell" style="color: var(--ink-soft)">
                {formatFigure(rate.buy, locale, decimals)}
              </td>
              <td class="px-3 py-3.5 text-right align-middle">
                <span class="figure text-[1.0625rem] font-bold tracking-[-0.03em]" style="color: var(--ink)">
                  {formatFigure(rate.sell, locale, decimals)}
                </span>
              </td>
              {hasTrend && (
                <td class="hidden px-3 py-3.5 text-right align-middle md:table-cell">
                  <Movement
                    change={rate.change}
                    changePct={rate.changePct}
                    locale={locale}
                    decimals={decimals}
                    size="sm"
                  />
                </td>
              )}
              <td
                class="px-3 py-3.5 text-right align-middle figure-cell font-bold"
                style="color: var(--ink)"
                data-ledger-cell
                data-buy={rate.buy ?? ''}
                data-sell={rate.sell ?? ''}
              >
                {formatFigure(rate.buy ? SEED * rate.buy : null, locale, decimals)}
              </td>
              <td class="hidden whitespace-nowrap px-4 py-3.5 text-right align-middle stamp sm:px-5 lg:table-cell" style="color: var(--ink-faint)">
                <time datetime={rate.updatedAt || undefined}>
                  {formatStamp(rate.updatedAt, timezone)}
                </time>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  {
    !hasTrend && (
      <p class="border-t px-4 py-4 text-[0.875rem] leading-relaxed sm:px-5" style="border-color: var(--rule); color: var(--ink-faint)">
        Todavía no hay un cierre anterior guardado para comparar. La variación diaria aparece en
        cuanto tengamos dos días de registro.
      </p>
    )
  }
</section>

<script>
  const table = document.querySelector('[data-ledger]');

  if (table) {
    const head = table.querySelector('[data-ledger-head]');
    const cells = Array.from(table.querySelectorAll('[data-ledger-cell]'));
    const decimals = Number(table.dataset.decimals) || 2;
    const locale = table.dataset.locale || 'es';

    window.addEventListener('cc:amount', (event) => {
      const detail = event.detail || {};
      const amount = Number(detail.amount);
      if (!Number.isFinite(amount)) return;

      const holdingUsd = detail.holdingUsd !== false;
      const digits = holdingUsd ? decimals : 2;

      if (head) {
        head.textContent =
          'Con ' +
          new Intl.NumberFormat(locale, { maximumFractionDigits: 2 }).format(amount) +
          ' ' +
          (holdingUsd ? 'USD' : detail.currency || '');
      }

      cells.forEach((cell) => {
        const buy = Number(cell.dataset.buy);
        const sell = Number(cell.dataset.sell);
        const applied = holdingUsd ? buy || sell : sell || buy;
        if (!Number.isFinite(applied) || applied === 0) {
          cell.textContent = '—';
          return;
        }
        const value = holdingUsd ? amount * applied : amount / applied;
        cell.textContent = new Intl.NumberFormat(locale, {
          minimumFractionDigits: digits,
          maximumFractionDigits: digits
        }).format(value);
      });
    });
  }
</script>
