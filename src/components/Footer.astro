---
import { countryList } from '../utils/countries.js';

const countries = countryList();
const year = new Date().getFullYear();

const site = [
  { href: '/metodologia', label: 'Cómo lo medimos' },
  { href: '/notas', label: 'Notas' },
  { href: '/api', label: 'API pública' },
  { href: '/integraciones', label: 'Widget para tu web' },
  { href: '/acerca-de', label: 'Acerca de' },
  { href: '/privacidad', label: 'Privacidad' },
  { href: '/terminos', label: 'Términos' },
  { href: '/contacto', label: 'Contacto' }
];
---

<footer class="mt-16" style="background-color: var(--cover); color: var(--cover-ink)">
  <div class="mx-auto max-w-shell px-4 py-10 sm:px-6 lg:px-8">
    <div class="grid gap-8 md:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)_minmax(0,1fr)]">
      <div>
        <p class="text-[0.9375rem] font-bold">Cambio Claro</p>
        <p class="mt-2.5 max-w-note text-[0.9375rem] leading-relaxed opacity-70">
          El precio del dólar en Latinoamérica, con el nombre de cada cotización y la hora en que
          fue medida. Guardamos nuestro propio registro para que exista un histórico donde nadie lo
          publica.
        </p>
      </div>

      <nav aria-label="Países">
        <p class="label opacity-50">Países</p>
        <ul class="mt-3.5 grid grid-cols-2 gap-x-4 gap-y-2">
          {
            countries.map((country) => (
              <li>
                <a
                  href={`/${country.code}/dolar-hoy`}
                  class="text-[0.9375rem] no-underline opacity-80 transition-opacity duration-150 hover:opacity-100"
                >
                  {country.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="El sitio">
        <p class="label opacity-50">El sitio</p>
        <ul class="mt-3.5 space-y-2">
          {
            site.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-[0.9375rem] no-underline opacity-80 transition-opacity duration-150 hover:opacity-100"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div
      class="mt-8 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3 border-t pt-5"
      style="border-color: rgba(250,250,248,0.18)"
    >
      <p class="text-[0.8125rem] opacity-60">© {year} Cambio Claro</p>
      <p class="max-w-note text-[0.8125rem] leading-relaxed opacity-60">
        Las cotizaciones son informativas y pueden diferir del precio que ofrece un banco o una casa
        de cambio. Este sitio no presta asesoramiento financiero.
      </p>
    </div>
  </div>
</footer>
