---
import Icon from './Icon.astro';

const { tone = 'cover' } = Astro.props;
---

<button
  type="button"
  id="theme-toggle"
  class="inline-flex h-8 w-8 items-center justify-center rounded-[2px] transition-opacity duration-200 hover:opacity-70"
  style={tone === 'cover' ? 'color: var(--cover-ink)' : 'color: var(--ink-soft)'}
  aria-label="Cambiar entre modo claro y oscuro"
>
  <span class="relative block h-[17px] w-[17px]">
    <span class="absolute inset-0 hidden dark:block"><Icon name="moon" size={17} /></span>
    <span class="absolute inset-0 block dark:hidden"><Icon name="sun" size={17} /></span>
  </span>
</button>

<script is:inline>
  (function () {
    var button = document.getElementById('theme-toggle');
    if (!button) return;
    button.addEventListener('click', function () {
      var root = document.documentElement;
      var next = root.classList.contains('dark') ? 'light' : 'dark';
      root.classList.toggle('dark', next === 'dark');
      root.style.colorScheme = next;
      try {
        localStorage.setItem('cc-theme', next);
      } catch (error) {
        void error;
      }
    });
  })();
</script>
