# Dominio final del sitio, sin barra al final.
# De aqui salen el canonical, el sitemap, robots.txt, llms.txt, el schema y la API.
PUBLIC_SITE_URL=https://elcambioclaro.com

# Search Console: el valor del atributo content de la etiqueta de verificacion HTML.
PUBLIC_GSC_VERIFICATION=

# Google Analytics 4, formato G-XXXXXXXXXX. Vacio = no se carga nada de Google.
PUBLIC_GA_ID=

# AdSense, formato pub-XXXXXXXXXXXXXXXX. Vacio = no se renderiza ningun bloque.
PUBLIC_ADSENSE_CLIENT=
